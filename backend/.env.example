# PostgreSQL (recommended for shared environments)
DATABASE_URL=postgresql+psycopg://sentimentiq:change-me@localhost:5432/sentimentiq
# Generate a unique random secret of at least 32 characters before production use
SENTIMENTIQ_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ENVIRONMENT=development
SENTIMENTIQ_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://localhost:8080
# Optional local SQLite override: SENTIMENTIQ_DB_PATH=./data/sentimentiq.db

# Optional SMTP for scheduled PDF reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
