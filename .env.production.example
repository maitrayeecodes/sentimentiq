# Copy to .env, replace all values, and keep .env out of version control.
POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_hex_24
SENTIMENTIQ_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# Optional SMTP settings. Without SMTP, scheduled PDFs are retained for download only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
